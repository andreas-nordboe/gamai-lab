@using Microsoft.AspNetCore.Components.Authorization
@inherits LayoutComponentBase
<PageTitle>GamAI Lab</PageTitle>

<MudThemeProvider Theme="_theme" IsDarkMode="_isDarkMode"/>
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <AuthorizeView>
        <MudAppBar Elevation="1">
            <MudIcon Color="Color.Primary" Icon="@Icons.Material.Rounded.Games"></MudIcon>
            <MudText Color="Color.Primary" Class="mx-1">/</MudText>
            <MudIcon Color="Color.Primary" Icon="@Icons.Material.Filled.Code"></MudIcon>
            <MudText Color="Color.Primary" Typo="Typo.h5" Class="ml-2" Style="font-weight: 900">GamAI Lab</MudText>
            <MudSpacer/>

            <MudButton Color="Color.Primary" Class="mx-2" StartIcon="@Icons.Material.Rounded.Home" Href="/">Home</MudButton>
            <MudButton Color="Color.Primary" Class="mx-2" StartIcon="@Icons.Material.Rounded.School" href="learning-progress" >Learning Progress</MudButton>
            <MudButton Color="Color.Primary" Class="mx-2" StartIcon="@Icons.Material.Rounded.Code" href="code-tasks">Code Tasks</MudButton>
            <MudButton Color="Color.Primary" Class="mx-2" StartIcon="@Icons.Material.Rounded.Cases" href="achievements" >Achievements</MudButton>

            @*This is a bit verbose but it works*@
            <AuthorizeView>
                <ChildContent Context="user">
                    <AuthorizeView Roles="Admin">
                        <ChildContent Context="adminUser">
                            <MudButton Color="Color.Primary" Class="mx-2" StartIcon="@Icons.Material.Rounded.Cases" href="code-task-management">Code Task Management</MudButton>
                            <MudButton Color="Color.Primary" Class="mx-2" StartIcon="@Icons.Material.Rounded.Cases" href="ai-persona-testing" >AI Persona Code Evaluation</MudButton>
                            <MudButton Color="Color.Primary" Class="mx-2" StartIcon="@Icons.Material.Rounded.Cases" href="analysis" >Analysis & Reporting</MudButton>
                        </ChildContent>
                    </AuthorizeView>
                    <AuthorizeView Roles="Educator,Admin">
                        <ChildContent Context="educatorAdmin">
                            <MudButton Color="Color.Primary" Class="mx-2" StartIcon="@Icons.Material.Rounded.Cases" href="code-task-management">Code Task Management</MudButton>
                            <MudButton Color="Color.Primary" Class="mx-2" StartIcon="@Icons.Material.Rounded.Cases" href="ai-persona-testing" >AI Persona Code Evaluation</MudButton>
                            <MudButton Color="Color.Primary" Class="mx-2" StartIcon="@Icons.Material.Rounded.Cases" href="analysis" >Analysis & Reporting</MudButton>
                            <MudButton Color="Color.Primary" Class="mx-2" StartIcon="@Icons.Material.Rounded.Monitor" href="educator-monitoring" >Educator Monitoring</MudButton>
                        </ChildContent>
                    </AuthorizeView>
                </ChildContent>
            </AuthorizeView>

            <MudSpacer/>
            <MudIconButton Color="Color.Primary" Icon="@Icons.Material.TwoTone.Logout" OnClick="LogoutUserAsync"  Edge="Edge.End"/>
        </MudAppBar>
    </AuthorizeView>

    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>
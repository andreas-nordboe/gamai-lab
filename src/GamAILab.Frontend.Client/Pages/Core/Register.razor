@page "/register"
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center" Style="height: 100vh">
    <MudPaper Height="420px" Width="100%" Elevation="12" Class="px-4 py-4">
        <MudText Align="Align.Center" Typo="Typo.h2" Style="font-weight: 900">GamAI Lab</MudText>
        <MudForm>
            <MudTextField Label="Email" @bind-Value="Email" Variant="Variant.Outlined"/>
            <MudTextField Label="Password" @bind-Value="Password" Variant="Variant.Outlined" InputType="@PasswordInput" Adornment="Adornment.End" AdornmentIcon="@PasswordInputIcon" OnAdornmentClick="TogglePassword" AdornmentAriaLabel="Show Password"/>
            <MudTextField Label="Repeat Password" @bind-Value="ConfrimPassword" Variant="Variant.Outlined" InputType="@ConfirmPasswordInput" Adornment="Adornment.End" AdornmentIcon="@ConfirmPasswordInputIcon" OnAdornmentClick="ToggleConfirmPassword" AdornmentAriaLabel="Show Confirm Password"/>
            <MudButton Class="my-2" FullWidth="true" Color="Color.Primary" Variant="Variant.Filled" OnClick="RegisterUserAsync">Register New User</MudButton>
            <MudButton Class="my-2" FullWidth="true" Color="Color.Primary" Variant="Variant.Filled" Href="/login">Back</MudButton>
        </MudForm>
    </MudPaper>

</MudContainer>
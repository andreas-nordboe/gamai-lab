@page "/code-tasks"
@using BlazorMonaco.Editor
@using GamAILab.Frontend.Client.Components.CodeTasks
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<MudContainer Class="pa-4" MaxWidth="MaxWidth.False">
    <MudText Align="Align.Center" Class="mb-4" Typo="Typo.h3">Code Task</MudText>
    
    <MudGrid Spacing="3">
        <MudItem xs="12" md="5">
            <MudText Typo="Typo.h5" Class="mb-2"> Instructions</MudText>
            
            <MudPaper Outlined="true" Class="pa-4 task-container">
                
                <MudText Typo="Typo.h5" Class="mb-3">
                    Instructions go here.
                </MudText>
                
                <MudText><strong>Requirements:</strong></MudText>
                Requirements list go here (for loop and add UI components)
            </MudPaper>
            
            <MudText Typo="Typo.h5" Class="mb-2">Progress</MudText>

            <MudPaper Outlined="true" Class="pa-4 progress-container">
                <MudText Typo="Typo.h5" Class="mb-2"><b>Attempts: </b>5</MudText>
                <MudText Typo="Typo.h5" Class="mb-2"><b>Hints used: </b>0</MudText>
                
                <MudStack Spacing="2" Class="mt-4"  Row="true" Justify="Justify.Center">
                    <MudButton FullWidth="true" Size="Size.Large" Color="Color.Primary" Variant="Variant.Filled" OnClick="GetCodeHint">Get Hint</MudButton>
                    <MudButton FullWidth="true" Size="Size.Large" Color="Color.Primary" Variant="Variant.Filled" OnClick="ResetCode">Reset Code</MudButton>
                </MudStack>

            </MudPaper>
            
        </MudItem>
        
        
        <MudItem xs="12" md="7">
            <MudText Typo="Typo.h5" Class="mb-2">Code Editor</MudText>
            <MudPaper Outlined="true" Class="editor-container">
                <CodeEditorPanel @ref="_codeEditorPanel" EditorId="code-editor" />
            </MudPaper>
            
            <MudStack Spacing="2"  Row="true" Justify="Justify.Center" Class="mt-3">
                <MudButton FullWidth="true" Size="Size.Large" Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitCode">Submit Code</MudButton>
                <MudButton FullWidth="true" Size="Size.Large" Disabled="_codeIsExecuting" Variant="Variant.Filled" Color="Color.Primary" OnClick="RunCode">
                    @(_codeIsExecuting ? "Running code..." : "Run Code")
                </MudButton>
            </MudStack>
            
            <MudText Class="mt-4 mb-2" Typo="Typo.h5">Code Output</MudText>
            
            <MudPaper Outlined="true" Class="output-container">
                <CodeEditorPanel @ref="_codeOutputPanel" EditorId="code-output" ReadOnly="true" />
            </MudPaper>
            
            
        </MudItem>
        
    </MudGrid>

</MudContainer>
@page "/code-tasks"

<MudTable Class="mx-4 my-4" Items="@_codeTasks" Hover="true" Breakpoint="Breakpoint.Sm" Loading="@_isLoadingCodeTasks" LoadingProgressColor="Color.Info">
    <HeaderContent>
        <MudTh>Title</MudTh>
        <MudTh>Description</MudTh>
        <MudTh>Action</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Title">@context.Title</MudTd>
        <MudTd DataLabel="Description">@context.Description</MudTd>
        <MudTd DataLabel="Action">
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@(() => OnTaskClicked(context))">
                Start Code Task
            </MudButton>
        </MudTd>
    </RowTemplate>
</MudTable>
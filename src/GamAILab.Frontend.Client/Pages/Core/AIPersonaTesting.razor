@page "/ai-persona-testing"
@using GamAILab.Shared.Models
@using GamAILab.Shared.Models.AIPersonaSimulation
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]

<MudText Typo="Typo.h3" Class="mx-2 mb-2">
    <b>AI persona Simulation</b>
</MudText>


<MudButton Class="mt-4 ml-4 mr-2" Disabled="_personaSimulationIsRunning" OnClick="@OnRunAIPersonaSimulationClicked" Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Filled.Start">Run AI Persona Simulation</MudButton>
<MudButton Class="mt-4 ml-4" OnClick="@OnAddAIPersonaClicked" Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Filled.Add">Add AI Persona</MudButton>



<MudStack Spacing="2">
    <MudSelect Class="my-2 mx-4 mt-4" T="CodeTask" Label="Selected Code Task" @bind-Value="@SelectedCodeTask" Variant="Variant.Outlined">
        @if (CodeTasks is not null)
        {
            @foreach (var codeTask in CodeTasks)
            {
                if (codeTask is not null)
                {
                    <!-- CRITICAL FIX: Changed T from "int" to "CodeTask" and Value from codeTask.Id to codeTask -->
                    <MudSelectItem T="CodeTask" Value="codeTask">
                        @codeTask.Title
                    </MudSelectItem>
                }
            }
        }
    </MudSelect>
    <MudNumericField Class="my-2 mx-4" @bind-Value="_executionCounts" Min="0" Max="10" Label="Execution Count" Variant="Variant.Outlined" />
</MudStack>


<MudTable Class="mx-4 my-4" T="AIPersona" MultiSelection="true" @bind-SelectedItems="SelectedAIPersonas" Items="AIPersonas" Hover="true" Breakpoint="Breakpoint.Sm" Loading="@_isLoadingAIPersonas" LoadingProgressColor="Color.Info">
    <HeaderContent>
        <MudTh>Persona Id</MudTh>
        <MudTh>Description</MudTh>
        <MudTh>Background</MudTh>
        <MudTh>Action</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Persona Id">@context.Id</MudTd>
        <MudTd DataLabel="Name">@context.Name</MudTd>
        <MudTd DataLabel="Background">@context.Background</MudTd>
        <MudTd DataLabel="Action">
            <MudButton Class="mr-2" Disabled="_personaSimulationIsRunning" EndIcon="@Icons.Material.Filled.ArrowRight" Color="Color.Primary" Variant="Variant.Filled" OnClick="@(() => OnAIPersonaClicked(context))">
                Run Code Simulation
            </MudButton>
            <MudButton Class="mr-2" EndIcon="@Icons.Material.Filled.Edit" Color="Color.Info" Variant="Variant.Filled" OnClick="@(() => EditAIPersonaClicked(context))">
                Edit
            </MudButton>
            <MudButton Class="mr-2" EndIcon="@Icons.Material.Filled.Delete" Color="Color.Error" Variant="Variant.Filled" OnClick="@(() => OnDeleteAIPersonaClicked(context.Id))">
                Delete
            </MudButton>
        </MudTd>
    </RowTemplate>
</MudTable>

<MudText Typo="Typo.h3" Class="mx-2 mb-2">
    <b>Code Simulation Result</b>
</MudText>

@if (string.IsNullOrWhiteSpace(_simulationResults))
{
    <MudText>
        @_simulationResults
    </MudText>
}
@using GamAILab.Frontend.Client.Components.CodeTasks
<MudDialog>
    <TitleContent>
        Code Task Feedback
    </TitleContent>
    <DialogContent>
        
         <MudContainer MaxWidth="MaxWidth.False" Class="pa-4">

            <MudText Typo="Typo.h4" Class="mb-1">
                @CodeSubmissionFeedback.CodeTask.Title
            </MudText>

            <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4">
                @CodeSubmissionFeedback.CodeTask.Description
            </MudText>

            <CodeEditorPanel EditorId="code-feedback-panel" DefaultCode="@CodeSubmissionFeedback.SubmittedCode" ReadOnly="true" />

            <MudGrid Spacing="3" Class="mt-2">

                <MudItem xs="12" md="6">
                    <MudStack Spacing="3">

                        <div>
                            <MudText Typo="Typo.h6" Class="mb-2">Code Execution</MudText>

                            <MudAlert Severity="@GetTaskOutcomeServerity(CodeSubmissionFeedback.AIFeedback.TaskOutcome)" Variant="Variant.Outlined" Class="result-container">
                            @*<MudPaper Class="pa-4 result-container" Outlined="true">*@
                                <MudText Color="@FormatOutcomeColor()">
                                    <b>Learning Outcome:</b>
                                    @CodeSubmissionFeedback.AIFeedback.TaskOutcome
                                </MudText>

                                <MudText>
                                    <b>Checks passed:</b>
                                    @PassedTests / @TotalTests
                                </MudText>

                                <MudText>
                                    <b>Runtime:</b>
                                    @CodeExecutionDuration
                                </MudText>

                                @if (CodeSubmissionFeedback.CodeExecution.TimedOut)
                                {
                                    <MudAlert Severity="Severity.Error" Class="mt-3">
                                        The code execution timed out
                                    </MudAlert>
                                }
                                else if (!string.IsNullOrWhiteSpace(CodeSubmissionFeedback.CodeExecution.FatalError))
                                {
                                    <MudAlert Severity="Severity.Error" Class="mt-3">
                                        @CodeSubmissionFeedback.CodeExecution.FatalError
                                    </MudAlert>
                                }
                            </MudAlert>
                        </div>

                        <div>
                            <MudText Typo="Typo.h6" Class="mb-2">
                                Test Results
                            </MudText>

                            <MudPaper Class="pa-4" Outlined="true">
                                @if (TotalTests == 0)
                                {
                                    <MudText>
                                        No test results were returned.
                                    </MudText>
                                }
                                else
                                {
                                    @foreach (var test in CodeSubmissionFeedback.CodeExecution.CodeTests)
                                    {
                                        <MudAlert Class="pa-3 mb-2" Severity="@(test.Passed ? Severity.Success : Severity.Error)" Variant="Variant.Outlined">
                                        @*<MudPaper Class="pa-3 mb-2" Outlined="true">*@
                                            <MudText><b>@test.Name</b></MudText>

                                            <MudText>Status:@(test.Passed ? "Passed" : "Failed")</MudText>

                                            <MudText>
                                                Expected: @FormatJsonValue(test.ExpectedResult)
                                            </MudText>

                                            <MudText>
                                                Actual: @FormatJsonValue(test.ActualOutput)
                                            </MudText>

                                            @if (!string.IsNullOrWhiteSpace(test.Error))
                                            {
                                                <MudText Color="Color.Error">
                                                    Error: @test.Error
                                                </MudText>
                                            }
                                        </MudAlert>
                                    }
                                }
                            </MudPaper>
                        </div>

                        
                        @if (@CodeSubmissionFeedback.HallucinationCheck is not null)
                        {
                            <div>
                            <MudText Typo="Typo.h6" Class="mb-2">
                                AI Hallucination Checker
                            </MudText>

                            <MudAlert Severity="@GetVerificationSeverity(CodeSubmissionFeedback.HallucinationCheck.Status)" Variant="Variant.Outlined" Class="verification-container">

                                <MudText Typo="Typo.subtitle1">
                                    <b>@GetHallucinationStatusTitle(CodeSubmissionFeedback.HallucinationCheck.Status)</b>
                                </MudText>

                                @if (!string.IsNullOrWhiteSpace(CodeSubmissionFeedback.HallucinationCheck.Summary))
                                {
                                    <MudText Class="mt-2">
                                        @CodeSubmissionFeedback.HallucinationCheck.Summary
                                    </MudText>
                                }

                                @if (CodeSubmissionFeedback.HallucinationCheck.ConflictedClaims.Length > 0 && CodeSubmissionFeedback.HallucinationCheck.ConflictedClaims != "[]")
                                {
                                    <MudText Class="mt-3">
                                        <b>Conflicting claims:</b>
                                    </MudText>
                                    <MudList T="string" Dense="true">
                                        @foreach (var conflictedClaim in CodeSubmissionFeedback.HallucinationCheck.ConflictedClaims)
                                        {
                                            <MudListItem T="string">
                                                @conflictedClaim
                                            </MudListItem>
                                        }
                                    </MudList>
                                }
                                <MudDivider Class="my-3" />
                                <MudText Typo="Typo.caption">
                                    Verification status: @GetHallucinationStatusText(CodeSubmissionFeedback.HallucinationCheck.Status)
                                </MudText>

                                @if (!string.IsNullOrWhiteSpace(CodeSubmissionFeedback.HallucinationCheck.LLMModelUsed))
                                {
                                    <MudText Typo="Typo.caption" Class="d-block">
                                        Verification LLM model used: @CodeSubmissionFeedback.HallucinationCheck.LLMModelUsed
                                    </MudText>
                                }

                                <MudText Typo="Typo.caption"Class="d-block">
                                    Verification processing time: @CodeSubmissionFeedback.HallucinationCheck.GenerationTimeInMilliseconds ms
                                </MudText>
                            </MudAlert>
                        </div>
                    }
                    else
                    {
                        <div>
                            <MudText Typo="Typo.h6" Class="mb-2">
                                AI Feedback Verification
                            </MudText>

                            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                                The AI feedback was not verified
                            </MudAlert>
                        </div>
                    }
                    </MudStack>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.h6" Class="mb-2">
                        AI Evaluation Output
                    </MudText>

                    <MudPaper Class="pa-4 evaluation-container" Outlined="true">
                        <MudText>
                            <b>Outcome:</b>
                            @CodeSubmissionFeedback.AIFeedback.TaskOutcome
                        </MudText>

                        <MudText Class="mt-3">
                            <b>Explanation:</b>
                        </MudText>

                        <MudText>
                            @CodeSubmissionFeedback.AIFeedback.Explanation
                        </MudText>

                        @if (!string.IsNullOrWhiteSpace(
                                 CodeSubmissionFeedback.AIFeedback.HintMessage))
                        {
                            <MudText Class="mt-4">
                                <b>Hint:</b>
                            </MudText>

                            <MudText>
                                @CodeSubmissionFeedback.AIFeedback.HintMessage
                            </MudText>
                        }

                        @if (FeedbackEvidence.Count > 0)
                        {
                            <MudText Class="mt-4">
                                <b>Evidence:</b>
                            </MudText>

                            <MudList T="string" Dense="true">
                                @foreach (var evidence in FeedbackEvidence)
                                {
                                    <MudListItem T="string">
                                        @evidence
                                    </MudListItem>
                                }
                            </MudList>
                        }
                    </MudPaper>
                </MudItem>

            </MudGrid>
        </MudContainer>
        
    </DialogContent>
    <DialogActions>
        
    </DialogActions>
</MudDialog>